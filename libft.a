/*   Updated: 2025/12/05 18:36:04 by klafi            ###   ########.fr       */
/*                                                                            */
/* ************************************************************************** */

#include "libft.h"

char	*ft_strchr(const char *s, int c)
{
	int	index;

	index = 0;
	while (*(s + index) != 0)
	{
		if (*(s + index) == c)
			return ((char *)(s + index));
		index++;
		if (*(s + index) == c)
			return ((char *)(s + index));
	}
	return (NULL);
}

