/*   Created: 2025/12/19 11:50:28 by klafi             #+#    #+#             */
/*   Updated: 2025/12/19 11:52:24 by klafi            ###   ########.fr       */
/*                                                                            */
/* ************************************************************************** */

#include "libft.h"

int	ft_lstsize(t_list *lst)
{
	int	count;

	count = 0;
	if (lst == NULL)
		return (0);
	while ((lst -> next) != NULL)
	{
		lst -> next = lst -> next;
		count++;
	}
	return (count);
}

