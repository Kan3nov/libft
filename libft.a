#include "libft.h"

void	*ft_memset(void *s, int c, size_t n)
{
	size_t	index;

	index = 0;
	while (n > 0)
	{
		*(unsigned char *)(s + index) = c;
		index++;
		n--;
	}
	return (s);
}

