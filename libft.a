/*   Updated: 2025/12/19 14:54:50 by klafi            ###   ########.fr       */
/*                                                                            */
/* ************************************************************************** */

#include "libft.h"

void	*ft_calloc(size_t n, size_t size)
{
	void	*ptr;

	if (size == 0 || n == 0)
		ptr = malloc(0);
	else if(n * size > UINT_MAX)
		return NULL;
	else
	{
		ptr = malloc(size * n);
		ft_bzero(ptr, size * n);
	}
	return ptr;
}
