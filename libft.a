/*   Updated: 2025/12/17 15:21:05 by klafi            ###   ########.fr       */
/*                                                                            */
/* ************************************************************************** */

#include "libft.h"

char	*ft_substr(char const *s, unsigned int start, size_t len)
{
	size_t	index;
	char	*new_str;

	if (len > ft_strlen((char *)(s + start)))
		len = ft_strlen((char *)(s + start));
	new_str = malloc(len + 1);
	if (!new_str)
		return (NULL);
	index = 0;
	while (index < len)
	{
		*(new_str + index) = *(s + index + start);
		index++;
	}
	*(new_str + index) = 0;
	return (new_str);
}

