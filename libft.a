/* ************************************************************************** */

#include "libft.h"

size_t	ft_strlen(const char *s)
{
	size_t	counter;
	size_t	index;

	counter = 0;
	index = 0;
	while (*(s + index) != 0)
	{
		counter++;
		index++;
	}
	return (counter);
}

